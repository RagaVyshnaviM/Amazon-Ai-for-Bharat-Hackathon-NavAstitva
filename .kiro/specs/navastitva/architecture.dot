digraph NavAstitva {
    rankdir=LR;
    node [shape=box, style="filled,rounded", fontname="Arial", fontsize=18];
    edge [color="#455A64", penwidth=3, arrowsize=1.0, fontsize=16];
    graph [bgcolor=white, pad=2.0, nodesep=1.5, ranksep=2.5, dpi=600];
    
    label="\n\nNavAstitva - AI-Powered Rural Skill Platform\n";
    labelloc=t;
    fontsize=28;
    fontname="Arial Bold";
    
    // Client Layer
    subgraph cluster_0 {
        label="Client Layer";
        style="filled,rounded";
        fillcolor="#E0F2F1";
        fontsize=20;
        fontname="Arial Bold";
        color="#4DB6AC";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        clients [label="Responsive Flutter App\n\n(Workers & Employers)", 
                fillcolor="#4DB6AC", fontcolor=white, width=4.0, height=1.8];
    }
    
    // Serverless Compute Layer
    subgraph cluster_1 {
        label="Serverless Compute Layer";
        style="filled,rounded";
        fillcolor="#E8EAF6";
        fontsize=20;
        fontname="Arial Bold";
        color="#3949AB";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        compute [label="AWS Lambda + API Gateway\n\nWorker Services | Employer Services\nVideo Processing | Payment Processing\nAI Contract Generation", 
                fillcolor="#3949AB", fontcolor=white, width=4.0, height=1.8];
    }
    
    // AI/ML Layer
    subgraph cluster_2 {
        label="AI/ML Layer";
        style="filled,rounded";
        fillcolor="#FFEBEE";
        fontsize=20;
        fontname="Arial Bold";
        color="#E53935";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        ai [label="Amazon Bedrock + Rekognition\n\nSkill Verification | Video Analysis\nMultilingual Support | Contract Generation", 
           fillcolor="#E53935", fontcolor=white, width=4.0, height=1.8];
    }
    
    // Storage Layer
    subgraph cluster_3 {
        label="Storage Layer";
        style="filled,rounded";
        fillcolor="#E3F2FD";
        fontsize=20;
        fontname="Arial Bold";
        color="#1E88E5";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        storage [label="S3 + DynamoDB + RDS\n\nProfiles | Jobs & Contracts | Equipment Data\nVideos | Digital Contracts | Transactions", 
                fillcolor="#1E88E5", fontcolor=white, width=4.0, height=1.8];
    }
    
    // Event-Driven Workflows Layer
    subgraph cluster_4 {
        label="Event-Driven Workflows Layer";
        style="filled,rounded";
        fillcolor="#FFF8E1";
        fontsize=20;
        fontname="Arial Bold";
        color="#FFC107";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        events [label="EventBridge + SQS + SNS\n\nJob & Contract Matching\nAsync Tasks | Push Notifications", 
               fillcolor="#FFC107", fontcolor="#263238", width=4.0, height=1.8];
    }
    
    // Security & Monitoring Layer
    subgraph cluster_5 {
        label="Security & Monitoring Layer";
        style="filled,rounded";
        fillcolor="#ECEFF1";
        fontsize=20;
        fontname="Arial Bold";
        color="#607D8B";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        security [label="IAM + Cognito + WAF + CloudWatch\n\nAuthentication | DDoS Protection\nMetrics & Logs", 
                 fillcolor="#607D8B", fontcolor=white, width=4.0, height=1.8];
    }
    
    // Edge Optimization Layer
    subgraph cluster_6 {
        label="Edge Optimization Layer";
        style="filled,rounded";
        fillcolor="#FFF9C4";
        fontsize=20;
        fontname="Arial Bold";
        color="#FFD54F";
        penwidth=4;
        labeljust="c";
        labelloc="t";
        
        edge_cdn [label="Amazon CloudFront CDN\n\nVideo Caching | Content Delivery\nLow Latency | Bandwidth", 
                 fillcolor="#FFD54F", fontcolor="#263238", width=4.0, height=1.8];
    }
    
    // Main flow
    clients -> compute [label="HTTPS"];
    compute -> ai [label="AI Process"];
    compute -> storage [label="Store Data"];
    compute -> events [label="Trigger"];
    events -> clients [label="Notify"];
    security -> compute [style=dashed, label="Protect"];
    edge_cdn -> clients [style=dashed, label="Accelerate"];
}
